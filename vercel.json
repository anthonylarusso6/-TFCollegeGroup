{
  "crons": [
    {
      "path": "/api/cron/weight-reminder",
      "schedule": "30 12 * * 1,5"
    },
    {
      "path": "/api/cron/session-end-reminder",
      "schedule": "30 16 * * 1,2,4,5"
    },
    {
      "path": "/api/cron/habits-reminder",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "buildCommand": "next build",
  "framework": "nextjs"
}
