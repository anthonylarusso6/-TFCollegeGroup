# Copy to .env.local and fill in real values. .env.local is gitignored.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API Keys in the Supabase dashboard.

# Browser-visible by design. The anon key is meant to be public; access is
# controlled by row-level security policies, not by hiding this value.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. The Supabase host used in the next.config.js image allowlist.
# Derived from NEXT_PUBLIC_SUPABASE_URL when unset; only set it if they differ.
# NEXT_PUBLIC_SUPABASE_HOSTNAME=your-project-ref.supabase.co

# Server-side only. Bypasses row-level security — never expose to the browser
# and never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Secrets ─────────────────────────────────────────────────────────────────
# Authorizes Vercel cron invocations.
CRON_SECRET=generate-a-random-string

# Web Push signing key for notifications.
VAPID_PRIVATE_KEY=your-vapid-private-key

# Guards privileged app actions.
APP_ACTION_SECRET=generate-a-random-string
NEXT_PUBLIC_APP_ACTION_SECRET=must-match-app-action-secret

# Guards the destructive reset endpoint.
RESET_SECRET=generate-a-random-string

# ── Third party ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
